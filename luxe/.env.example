# Luxe storefront → CRM ingest
# Внутренний URL CRM (доступен серверу luxe). В docker compose — имя сервиса.
CRM_URL=http://mvst-crm:3001
# Публичный URL CRM (доступен из браузера пользователя). Используется для
# абсолютизации относительных путей фото бутиков (`/uploads/boutiques/...`).
# В production обязательно задавать публичный домен CRM.
CRM_PUBLIC_URL=https://crmmvst.tsumteam.ru
CRM_INGEST_KEY=
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
