# Postgres (used by docker-compose for the postgres service)
POSTGRES_DB=mvst_crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# Host-side ports nginx will proxy to. Change here if 3000/3101 are taken.
# Containers listen on fixed internal ports (site=3000, crm=3001).
SITE_HOST_PORT=3000
CRM_HOST_PORT=3101
