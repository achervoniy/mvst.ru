# CRM container env (passed via env_file in docker-compose)
NODE_ENV=production

# Postgres — service name "postgres" comes from docker-compose
DATABASE_URL=postgresql://crm:CHANGE_ME_strong_random_password@postgres:5432/mvst_crm

# Session
SESSION_PASSWORD=REPLACE_WITH_32+_CHAR_RANDOM_STRING
SESSION_COOKIE_NAME=mvst_crm_session
SESSION_COOKIE_SECURE=true

# Initial admin (used only when seed runs)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Must match CRM_INGEST_KEY in site.env
CRM_INGEST_KEY=REPLACE_WITH_STRONG_SHARED_SECRET

# Set to "true" on first boot to seed boutiques + admin, then change to "false"
RUN_SEED=false
