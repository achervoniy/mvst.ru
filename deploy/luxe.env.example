NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Same secret as crm.env CRM_INGEST_KEY — luxe → CRM ingest auth
CRM_URL=http://mvst-crm:3001
CRM_INGEST_KEY=

# Публичный URL CRM (как видит браузер). Используется для абсолютизации
# относительных путей `/uploads/...` (фото бутиков). Без этой переменной
# браузер пытается грузить картинки с внутреннего docker-хоста mvst-crm
# и получает ошибку — поэтому фото бутиков на сайте не появляются.
CRM_PUBLIC_URL=https://crmmvst.tsumteam.ru
